# Entity: data_champion

main: kit: entity: data_champion: {

  alias: field: {}

  fields: [
    {
      name: "image"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "key"
      req: false
      short: "Champion ID"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Champion name"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Champion title"
      type: "`$STRING`"
    }
  ]

  name: "data_champion"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "en_US"
                kind: "param"
                name: "language"
                orig: "language"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "12.6.1"
                kind: "param"
                name: "version"
                orig: "version"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cdn/{version}/data/{language}/champion.json"
          segments: [
            {
              lit: "cdn"
            }
            {
              var: "version"
            }
            {
              lit: "data"
            }
            {
              var: "language"
            }
            {
              lit: "champion.json"
            }
          ]
          select: {
            exist: [
              "language"
              "version"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "cdn"
        "data"
      ]
    ]
  }



}
