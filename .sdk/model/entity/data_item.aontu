# Entity: data_item

main: kit: entity: data_item: {

  alias: field: {}

  fields: {
    data: {
      h: "Data"
      n: "data"
      r: false
      t: "`$OBJECT`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      t: "`$STRING`"
    }
    version: {
      h: "Version"
      n: "version"
      r: false
      t: "`$STRING`"
    }
  }

  name: "data_item"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /cdn/{version}/data/{language}/item.json"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "en_US"
                k: "param"
                n: "language"
                or: "language"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "12.6.1"
                k: "param"
                n: "version"
                or: "version"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/cdn/{version}/data/{language}/item.json"
          q: {
            exist: [
              "language"
              "version"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "cdn"
            }
            {
              var: "version"
            }
            {
              lit: "data"
            }
            {
              var: "language"
            }
            {
              lit: "item.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
