# BasicDataItemFlow

main: kit: flow: BasicDataItemFlow:
{
  entity: "data_item",
  kind: "basic",
  name: "BasicDataItemFlow",
  step: [
    {
      i: {
        ref: "data_item_ref01",
        srcdatavar: "data_item_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "data_item01",
        version: "version01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-data_item_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDataItemFlow"
}